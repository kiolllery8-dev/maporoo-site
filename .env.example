# MAPOROO — 環境變數範本
# 複製成 .env 後填入實際值。.env 已被 .gitignore 排除，絕對不要提交進版控。

# ── 基本 ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# SQLite 資料庫所在目錄。Docker 內是 /app/data（compose 掛 volume）。
DATA_DIR=/app/data

# ── 後台位置 ────────────────────────────────────────────────
# 做法對齊 auslife.tw：後台走獨立子網域，跟前台同一個容器。
# 本機開發時 host 不符，會自動 fallback 到 /admin 路徑。
ADMIN_HOST=admin.maporoo.com
SITE_HOST=maporoo.com

# ── 初始管理者 ──────────────────────────────────────────────
# 這兩行留空就好。
#
# 資料庫還沒有任何管理者時，第一次開啟 /admin 會自動建立帳號：
#   帳號：admin@maporoo.com
#   密碼：系統產生的隨機強密碼，印在伺服器 log（docker logs maporoo）
#         只印這一次，而且第一次登入強制改密碼。
#
# 想自己指定的話才填下面兩行，建立完成後請把它們刪掉。
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ── 金流（目前未接）──────────────────────────────────────────
# 老闆 2026-08-06 決定：付款先留在本地，線上金流由後續工程師接手。
# 目前只開匯款（bank_transfer）與貨到付款（cod）。
# 接手時把下面填好並實作 app/lib/payment.ts 的 TODO。
PAYMENT_PROVIDER=manual
# 匯款帳戶資訊，會顯示在訂單完成頁與通知信裡。
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=

# 藍新 NewebPay（保留給後續工程師，目前不讀取）
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
NEWEBPAY_ENV=sandbox

# ── 寄信（可選）─────────────────────────────────────────────
# 留空 = 註冊不需 email 驗證，直接開通。
RESEND_API_KEY=
MAIL_FROM=MAPOROO <noreply@maporoo.com>
